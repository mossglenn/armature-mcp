{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "isolatedModules": true
  },
  "include": ["src", "test"]
}
